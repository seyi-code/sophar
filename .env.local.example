# =============================================================================
# Sophar — Environment Variables
# Copy to .env.local and fill in real values
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Postgres + pgvector recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sophar

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Social login (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Web search (optional)
# TAVILY_API_KEY=
# SERPER_API_KEY=

# E2B Code Interpreter (optional)
# E2B_API_KEY=

# Vertical
NEXT_PUBLIC_DEFAULT_VERTICAL=enterprise
